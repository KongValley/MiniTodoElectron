{
  "name": "mini-todo",
  "version": "1.0.0",
  "description": "迷你待办 —— 基于 Electron 的看板式待办管理工具",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import ./scripts/ts-resolve-hook.mjs --experimental-strip-types --test src/shared/store-ops.test.ts",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "node scripts/run-smokes.mjs",
    "perf": "node scripts/perf-compare.mjs current 3",
    "perf:data": "node scripts/gen-perf-data.mjs",
    "dist:win7-32": "npm run build && node scripts/package-win.mjs win7-ia32",
    "dist:win7-64": "npm run build && node scripts/package-win.mjs win7-x64",
    "dist:win10-32": "npm run build && node scripts/package-win.mjs win10-ia32",
    "dist:win10-64": "npm run build && node scripts/package-win.mjs win10-x64",
    "dist": "npm run dist:win7-32 && npm run dist:win10-64 && npm run dist:win10-32 && npm run dist:win7-64"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "2.3.0",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "vue": "3.4.38",
    "vue-tsc": "2.2.12"
  },
  "build": {
    "appId": "com.locale.minitodo",
    "productName": "迷你待办",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@22.3.27": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
